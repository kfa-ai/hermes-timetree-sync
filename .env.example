# Copy to .env for local development. Do not commit .env.

# Option A: session-cookie auth, preferred for early read-only experiments.
TIMETREE_SESSION_COOKIE=

# Option B: email/password auth. Run `uv run hermes-timetree-sync sign-in`
# to exchange these for a TimeTree session cookie, then store only the cookie
# if you do not want the password kept in .env.
TIMETREE_EMAIL=
TIMETREE_PASSWORD=

# Calendar to mirror once known.
TIMETREE_CALENDAR_ID=

# Future Google Calendar mirror target.
GOOGLE_CALENDAR_ID=
