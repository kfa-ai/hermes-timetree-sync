# Copy to .env for local development. Do not commit .env.

# Option A: session-cookie auth, preferred for early read-only experiments.
TIMETREE_SESSION_COOKIE=

# Option B: login-flow auth, if implemented/needed.
TIMETREE_EMAIL=
TIMETREE_PASSWORD=

# Calendar to mirror once known.
TIMETREE_CALENDAR_ID=

# Future Google Calendar mirror target.
GOOGLE_CALENDAR_ID=
